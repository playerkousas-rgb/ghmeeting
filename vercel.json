{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "ignoreCommand": "git log -1 --pretty=%B|grep -qiE '\\[skip (ci|vercel)\\]|\\[(ci|vercel) skip\\]'&&exit 0;git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!docs' ':!tests' ':!tools' ':!scripts' ':!.github' ':!*.md' ':!icons/svg' ':!*.src.png'||exit 1;exit 0"
}
